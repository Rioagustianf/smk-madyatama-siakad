generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Major {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  description     String?
  image           String?
  facilities      Json?
  careerProspects Json?
  totalStudents   Int      @default(0)
  isActive        Boolean? @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classes         SchoolClass[]
}

model Student {
  id         String   @id @default(cuid())
  studentId  String   @unique
  username   String   @unique
  password   String?
  name       String
  class      String
  major      String
  phone      String?  @default("") // WA Number

  nisn       String?
  year       Int
  gradeLevel Int
  semester   Int
  isActive   Boolean  @default(true)
  role       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  grades     Grade[]
  attendances Attendance[]
  bills      Bill[]
}

model Teacher {
  id         String   @id @default(cuid())
  name       String
  username   String   @unique
  password   String?
  phone      String?
  education  String?
  subjects   Json?
  classes    Json?
  isActive   Boolean? @default(true)
  role       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  taughtSubjects Subject[] @relation("TeacherSubjects")
  homeroomClasses SchoolClass[]  @relation("HomeroomTeacher")
  grades        Grade[]
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  teacherId   String?
  isActive    Boolean? @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher? @relation("TeacherSubjects", fields: [teacherId], references: [id])
  grades      Grade[]
  examSchedules ExamSchedule[]
  attendances   Attendance[]

  @@index([teacherId], name: "idx_subjects_teacherId")
}

model SchoolClass {
  id                String   @id @default(cuid())
  name              String   @unique
  majorId           String?
  homeroomTeacherId String?
  isActive          Boolean? @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  major             Major?   @relation(fields: [majorId], references: [id])
  homeroomTeacher   Teacher? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  examSchedules     ExamSchedule[]

  @@index([majorId], name: "idx_classes_majorId")
  @@index([homeroomTeacherId], name: "idx_classes_homeroomTeacherId")
  @@map("classes")
}

model ExamSchedule {
  id          String   @id @default(cuid())
  subjectId   String
  classId     String
  type        String   // midterm, final, assignment
  date        DateTime
  startTime   String
  endTime     String
  room        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject     @relation(fields: [subjectId], references: [id])
  class       SchoolClass @relation(fields: [classId], references: [id])

  @@index([subjectId], name: "idx_examSchedules_subjectId")
  @@index([classId], name: "idx_examSchedules_classId")
}

model Schedule {
  id         String   @id @default(cuid())
  day        String
  time       String
  subject    String
  class      String
  teacher    String?
  isActive   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String?
  subjectId   String?
  teacherId   String?
  semester    Int
  year        Int
  assignments Decimal? @db.Decimal(10, 2)
  midterm     Decimal? @db.Decimal(10, 2)
  final       Decimal? @db.Decimal(10, 2)
  total       Decimal? @db.Decimal(10, 2)
  grade       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student    Student? @relation(fields: [studentId], references: [id])
  subject    Subject? @relation(fields: [subjectId], references: [id])
  teacher    Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId], name: "idx_grades_studentId")
  @@index([subjectId], name: "idx_grades_subjectId")
  @@index([teacherId], name: "idx_grades_teacherId")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String?
  excerpt     String?
  image       String?
  category    String?
  priority    String?
  isPublished Boolean? @default(false)
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String?
  url         String?
  thumbnail   String?
  category    String?
  tags        Json?
  isPublished Boolean? @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id           String   @id @default(cuid())
  title        String
  description  String?
  image        String?
  category     String?
  level        String?
  date         DateTime?
  participants Json?
  isPublished  Boolean? @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Staff {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  password       String?
  role           String?  // "finance", "academic", etc
  position       String?
  department     String?
  email          String?
  phone          String?
  image          String?
  bio            String?
  education      String?
  experience     Int?
  certifications Json?
  isActive       Boolean? @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Admin {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  password    String?
  permissions Json?
  isActive    Boolean? @default(true)
  role        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id               String   @id @default(cuid()) @map("_id")
  singleton        Boolean? @default(false) @map("_singleton")
  name             String?
  address          Json?
  phone            String?
  email            String?
  website          String?
  logo             String?
  history          String? @db.Text
  historyImage     String?
  vision           String? @db.Text
  mission          String? @db.Text
  principalName    String?
  principalImage   String?
  principalMessage String? @db.Text
  facilities       Json?
  organization     Json?
  contact          Json?
  updatedAt        DateTime @updatedAt
}

model InternshipPartner {
  id          String   @id @default(cuid())
  name        String
  address     String?
  contact     String?
  phone       String?
  description String?
  isActive    Boolean? @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules  InternshipSchedule[]
}

model InternshipSchedule {
  id         String   @id @default(cuid())
  partnerId  String
  class      String
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  isActive   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  partner    InternshipPartner @relation(fields: [partnerId], references: [id])

  @@index([partnerId], name: "idx_internshipSchedules_partnerId")
}

model AcademicEvent {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  type        String   @default("EVENT") // EVENT, HOLIDAY, ADMISSION
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  date      DateTime @db.Date // YYYY-MM-DD
  timeIn    DateTime @default(now())
  status    String // PRESENT, LATE, SICK, PERMISSION, ALPHA
  latitude  Float?
  longitude Float?
  photoUrl  String?
  notes     String?  @db.Text
  
  // Verification
  isVerified  Boolean  @default(false)
  verifiedBy  String?  // Nama guru yang memverifikasi
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, date])
}

model AttendanceSettings {
  id             String   @id @default(cuid())
  schoolName     String   @default("SMK Madyatama")
  latitude       Float    @default(0)
  longitude      Float    @default(0)
  radius         Int      @default(50) // meters
  updatedAt      DateTime @updatedAt
}

// Finance Models
model Bill {
  id          String   @id @default(cuid())
  studentId   String
  title       String   // e.g. "SPP Januari 2024"
  amount      Decimal  @db.Decimal(10, 2)
  type        String   // SPP, BUILDING, EXAM, OTHER
  status      String   // PENDING, PAID, OVERDUE, CANCELLED
  dueDate     DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student   @relation(fields: [studentId], references: [id])
  payments    Payment[]

  @@index([studentId], name: "idx_bills_studentId")
}

model Payment {
  id          String   @id @default(cuid())
  billId      String
  amount      Decimal  @db.Decimal(10, 2)
  method      String   // CASH, TRANSFER
  status      String   // PENDING, VERIFIED, FAILED
  proofUrl    String?  // Bukti transfer
  paidAt      DateTime @default(now())
  verifiedBy  String?  // Admin name
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bill        Bill     @relation(fields: [billId], references: [id])

  @@index([billId], name: "idx_payments_billId")
}

// Notification & System Models
model Notification {
  id        String   @id @default(cuid())
  userId    String   // ID penerima (Student.id, Teacher.id, atau Admin.id)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link      String?  // URL redirect saat diklik (opsional)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId], name: "idx_notifications_userId")
}

model SiteSettings {
  id            String   @id @default(cuid())
  whatsappToken String?  // Token Device Fonnte untuk Sekolah ini
  whatsappName  String?  // Nama Device/Sekolah
  updatedAt     DateTime @updatedAt
}